# extractor/.env.example — 새 추출 서비스가 읽는 값
#
# 실제 값은 Railway 서비스의 환경변수로 넣는다. 이 파일은 예시일 뿐이며
# 이미지에도 들어가지 않는다(.dockerignore).
#
# 이 서비스가 읽는 앱 변수는 아래 하나뿐이다. 분석·DB 자격증명
# (ANTHROPIC_API_KEY · OPENAI_API_KEY · SUPABASE_*)은 넣지 않는다.
# 임의 URL 을 읽어 오는 서비스이므로, 여기에 다른 자격증명을 두지 않는 것이
# 설계의 일부다.

# cr-report 의 /api/extract 가 X-CR-Extract-Key 헤더로 보내는 값과 같아야 한다.
# 최소 32바이트의 암호학적 난수를 쓴다 (예: python -c "import secrets;
# print(secrets.token_urlsafe(32))"). cr-check 의 기존 키를 재사용하지 않는다.
EXTRACT_API_KEY=replace-with-a-new-random-secret

# PORT 는 Railway 가 넣어 준다. 로컬에서만 필요하면 지정한다.
# PORT=8000
