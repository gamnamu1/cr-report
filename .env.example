# Supabase (필수)
# Supabase 프로젝트의 Project Settings > API 에서 확인
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key

# 사이트 정식 도메인 (필수)
# canonical URL · OG url · robots.txt · sitemap.xml · 공유 링크 생성의 기준값.
# 접속 호스트(critical-readers.vercel.app 등)와 무관하게 항상 이 값이 쓰인다.
NEXT_PUBLIC_SITE_URL=https://cr-report.kr

# 기사 추출 (리포트 만들기의 기사 자동 불러오기 기능을 쓸 때 필요)
# 아래 둘은 **함께** 설정한다. 하나라도 비어 있으면 /api/extract 는 외부를
# 호출하지 않고 503 을 돌려준다 (기사 불러오기만 막히고 리포트 읽기·검색은
# 그대로 된다). 기본 주소로의 폴백은 없다.
#
# EXTRACT_API_KEY 는 서버 전용이다 — NEXT_PUBLIC_ 접두어를 붙이면 브라우저
# 번들에 노출되므로 절대 붙이지 않는다.
EXTRACT_API_KEY=your-extract-api-key

# 추출 서비스의 베이스 URL (기사 자동 불러오기를 쓸 때 필수)
# cr-report 전용 extractor 서비스의 origin 이다. 이 저장소의 extractor/ 를
# 배포한 주소를 넣는다 (extractor/README.md 참고).
#
# origin 만 넣는다 — 코드가 /extract 를 붙인다. 끝에 /extract 를 붙이거나
# query·fragment·사용자명을 넣으면 잘못된 설정으로 보고 503 이 된다. 값을
# 임의로 보정하지 않는다. 앞뒤 공백과 끝 슬래시만 정리한다.
#
# 로컬에서 extractor 를 직접 띄웠다면 http://127.0.0.1:8000 같은 주소도 된다.
EXTRACT_API_BASE=https://your-extractor.example.com

# 노출 플래그 (선택)
# 문자열 "true" 이면 홈 풋터를 노출하고 /analyze 를 색인·sitemap 대상에 포함한다.
# false 또는 미설정이면 홈 풋터가 숨겨지고 /analyze 는 noindex 가 되지만
# 직접 URL 접근은 가능하다.
ANALYZE_PUBLIC=false
